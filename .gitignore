# Build output. The glob is deliberate: the firmware has at least two build trees (ARM at
# build/, host tests at build-host/) and a bare `build/` pattern silently lets the others in.
build*/
cmake-build-*/
*.uf2
*.elf
*.bin
*.hex
*.dis
*.map

# Generated firmware headers (produced by the CMake portal-embed step)
firmware/src/provisioning/portal_html.h

# Toolchain / editor
.vscode/
.idea/
compile_commands.json
CMakeCache.txt
CMakeFiles/

# Node
node_modules/
npm-debug.log*

# Local config that must never be committed — these hold Wi-Fi credentials
# and device tokens.
*.local.json
relay-reference/config.json
remotewake-config.uf2
secrets.env
.env

# OS
.DS_Store
Thumbs.db
desktop.ini

# Screenshots from MCP-driven verification (never committed)
tmp-screenshots/
.playwright-mcp/

# Signing keys never live in the repo. The public half is committed as
# firmware/src/ota/signing_key.c; private keys belong in ~/.remotewake/.
*.pem
